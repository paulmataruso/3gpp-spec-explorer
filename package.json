{
  "name": "3gpp-spec-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "Offline 3GPP specification explorer: crawler, SQLite FTS search server and an embeddable web component.",
  "license": "MIT",
  "author": "paulmataruso",
  "homepage": "https://github.com/paulmataruso/3gpp-spec-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmataruso/3gpp-spec-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/paulmataruso/3gpp-spec-explorer/issues"
  },
  "keywords": [
    "3gpp",
    "5g",
    "lte",
    "nr",
    "telecom",
    "specifications",
    "full-text-search",
    "sqlite",
    "web-component",
    "lit"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "crawl": "node scraper/crawl.ts",
    "docx": "node scraper/docx.ts",
    "figures": "node scraper/figures.ts",
    "build:db": "node scraper/build-db.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/server.js",
    "dev": "node --watch server/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "katex": "^0.16.47",
    "lit": "^3.3.3",
    "lucide": "^1.71.0"
  }
}
